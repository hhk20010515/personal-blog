# 生产环境环境变量模板
# 部署到 Vercel 时，请将这些变量添加到 Vercel 项目设置中

# 数据库连接 (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@your-host.neon.tech/database?sslmode=require&channel_binding=require"

# NextAuth 配置
NEXTAUTH_SECRET="your-nextauth-secret-generate-new-one"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Google OAuth (生产环境)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# WeChat OAuth (可选，中国用户)
WECHAT_APP_ID="your-wechat-app-id"
WECHAT_APP_SECRET="your-wechat-app-secret"

# 邮件服务 (Gmail SMTP，可选)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-gmail-app-password"
EMAIL_FROM="your-email@gmail.com"

# 文件上传服务 (可选)
UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# Cloudinary 媒体存储 (可选)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# 注意事项:
# 1. 将 NEXTAUTH_URL 替换为你的实际域名
# 2. 如果使用自定义域名，需要在 Google OAuth 中添加相应的重定向 URI
# 3. 生产环境建议重新生成 NEXTAUTH_SECRET
# 4. 确保所有敏感信息都通过 Vercel 环境变量设置，不要提交到代码仓库